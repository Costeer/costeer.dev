{
  "name": "costeer.dev",
  "version": "0.1.0",
  "type": "module",
  "description": "Personal multilingual Astro site for technical notes and political writing.",
  "license": "MIT",
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && bun run pagefind",
    "preview": "astro preview",
    "serve": "bun run build && bun preview",
    "astro": "astro",
    "pagefind": "pagefind --site dist --output-subdir _pagefind && rm -f dist/_pagefind/pagefind-ui.css dist/_pagefind/pagefind-ui.js dist/_pagefind/pagefind-component-ui.css dist/_pagefind/pagefind-component-ui.js dist/_pagefind/pagefind-modular-ui.css dist/_pagefind/pagefind-modular-ui.js",
    "postbuild": "echo \"Pagefind index generated in dist/_pagefind\"",
    "typecheck": "astro check",
    "test": "bun test",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{astro,ts,tsx,js,jsx,md,mdx,css,json}\"",
    "format:check": "prettier --check \"**/*.{astro,ts,tsx,js,jsx,md,mdx,css,json}\"",
    "check": "astro check && eslint . --max-warnings=0 && prettier --check \"**/*.{astro,ts,tsx,js,jsx,md,mdx,css,json}\" && astro build"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.6",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.2",
    "astro": "^6.3.7",
    "astro-expressive-code": "^0.42.0",
    "astro-icon": "^1.1.5",
    "astro-seo": "^1.1.0",
    "lenis": "^1.3.23",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@eslint/js": "^10.0.1",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "5.2.8",
    "@fontsource/lato": "5.2.7",
    "@fontsource/lexend": "^5.2.11",
    "@fontsource/opendyslexic": "^5.2.5",
    "@fontsource/source-sans-3": "5.2.9",
    "@iconify-json/lucide": "^1.2.109",
    "@iconify-json/material-symbols": "^1.2.74",
    "@iconify-json/simple-icons": "^1.2.83",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.0",
    "@types/bun": "^1.3.14",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "eslint": "^10.4.0",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "katex": "^0.16.47",
    "pagefind": "^1.5.2",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-external-links": "^3.0.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "satori": "^0.26.0",
    "shiki": "^4.1.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  },
  "overrides": {
    "brace-expansion": "5.0.6",
    "devalue": "5.8.1",
    "fast-uri": "3.1.2",
    "fast-xml-builder": "1.2.0",
    "yaml": "2.9.0"
  },
  "keywords": [
    "astro",
    "personal-site",
    "blog",
    "tailwindcss",
    "mdx",
    "pagefind",
    "mastodon",
    "i18n",
    "blog"
  ]
}
