---
import { SEO as AstroSEO } from 'astro-seo';
import { SITE } from '../config';
import { localizedPath, withBase } from '../i18n/utils';
import type { SeoMeta } from '../utils/seo';

interface Props {
  meta: SeoMeta;
}

const { meta } = Astro.props;

// Feed auto-discovery — feed readers and browser extensions look for
// these <link rel="alternate"> tags in <head>. We advertise the active
// locale's feed as the primary one, and (when multilingual) every other
// locale's feed too.
const localeSuffix = (locale: string) =>
  locale === SITE.defaultLocale ? '' : ` (${locale.toUpperCase()})`;
const primaryFeed = {
  href: localizedPath('/rss.xml', meta.locale),
  title: `${SITE.title}${localeSuffix(meta.locale)} — RSS`,
};
const otherFeeds = SITE.multilingual
  ? SITE.locales
      .filter((l) => l !== meta.locale)
      .map((l) => ({
        href: localizedPath('/rss.xml', l),
        title: `${SITE.title}${localeSuffix(l)} — RSS`,
      }))
  : [];
const sitemapHref = withBase('/sitemap-index.xml');
const ogLocale = meta.locale === 'de' ? 'de_DE' : 'en_US';
const alternateOgLocales = SITE.multilingual
  ? meta.hreflangs
      .map(({ locale }) => locale)
      .filter((locale) => locale !== meta.locale && locale !== 'x-default')
      .map((locale) => (locale === 'de' ? 'de_DE' : 'en_US'))
  : [];
const languageAlternates = SITE.multilingual
  ? meta.hreflangs.map(({ locale, href }) => ({ hrefLang: locale, href }))
  : undefined;
const feedLinks = [primaryFeed, ...otherFeeds].map((feed) => ({
  rel: 'alternate',
  type: 'application/rss+xml',
  title: feed.title,
  href: feed.href,
}));
const article =
  meta.type === 'article'
    ? {
        publishedTime: meta.publishedTime,
        modifiedTime: meta.modifiedTime,
        authors: [SITE.author.name],
        tags: meta.tags,
      }
    : undefined;
const metaTags =
  meta.type === 'article' ? [{ name: 'fediverse:creator', content: '@costeer@mastodon.de' }] : [];
---

<AstroSEO
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
  robotsExtras="max-image-preview:large"
  languageAlternates={languageAlternates}
  openGraph={{
    basic: {
      title: meta.title,
      type: meta.type,
      image: meta.ogImage,
      url: meta.canonical,
    },
    optional: {
      description: meta.description,
      locale: ogLocale,
      localeAlternate: alternateOgLocales,
      siteName: SITE.title,
    },
    image: {
      alt: `${SITE.title} social preview image`,
    },
    article,
  }}
  twitter={{
    card: 'summary_large_image',
    title: meta.title,
    description: meta.description,
    image: meta.ogImage,
    imageAlt: `${SITE.title} social preview image`,
  }}
  extend={{
    link: [...feedLinks, { rel: 'sitemap', type: 'application/xml', href: sitemapHref }],
    meta: metaTags,
  }}
/>
