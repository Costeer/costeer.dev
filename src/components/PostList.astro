---
import type { Locale } from '../config';
import { useTranslations } from '../i18n/utils';
import type { Post } from '../utils/posts';
import PostCard from './PostCard.astro';

interface Props {
  posts: Post[];
  locale: Locale;
  animate?: boolean;
  /** Let the browser skip off-screen card rendering until scrolled near them. */
  lazyRender?: boolean;
  showReadingDepth?: boolean;
}

const {
  posts,
  locale,
  animate = false,
  lazyRender = false,
  showReadingDepth = false,
} = Astro.props;
const t = useTranslations(locale);
---

{
  posts.length === 0 ? (
    <p class="border-base-300 text-base-content rounded-none border border-dashed px-6 py-10 text-center">
      {t('list.empty')}
    </p>
  ) : (
    <div id="post-list" data-card-list-animate={animate ? 'true' : undefined}>
      {posts.map((post, index) => (
        <PostCard
          post={post}
          locale={locale}
          prioritizeLcp={index === 0}
          animate={animate}
          animationDelay={`${Math.min(index * 80, 500)}ms`}
          lazyRender={lazyRender}
          showReadingDepth={showReadingDepth}
        />
      ))}
    </div>
  )
}

<script is:inline>
  (() => {
    const hydrateCardAnimations = () => {
      const list = document.querySelector('[data-card-list-animate="true"]');
      if (!(list instanceof HTMLElement)) return;

      const cards = Array.from(list.querySelectorAll('[data-card-animate="true"]')).slice(0, 8);

      cards.forEach((card) => {
        if (!(card instanceof HTMLElement)) return;

        requestAnimationFrame(() => {
          card.classList.add('chirpy-card-float-in');
        });
      });
    };

    hydrateCardAnimations();
  })();
</script>
