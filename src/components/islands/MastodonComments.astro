---
/**
 * Mastodon comments island.
 *
 * Each post points at the Mastodon status that announces it via
 * `mastodonStatusUrl` frontmatter. Public replies to that status are fetched
 * from the status context endpoint and rendered as comments.
 */
import { MASTODON_COMMENTS, type Locale } from '../../config';
import { useTranslations } from '../../i18n/utils';
import { Icon } from 'astro-icon/components';

interface Props {
  locale: Locale;
  statusUrl?: string;
  /** Per-post override; defaults to true. */
  enabled?: boolean;
}

const { locale, statusUrl, enabled = true } = Astro.props;
const t = useTranslations(locale);

function statusInfoFromUrl(url?: string): { id: string; instance: string } {
  if (!url) return { id: '', instance: '' };
  try {
    const parsed = new URL(url);
    return {
      id: parsed.pathname.split('/').filter(Boolean).at(-1) ?? '',
      instance: parsed.origin,
    };
  } catch {
    return { id: '', instance: '' };
  }
}

const statusInfo = statusInfoFromUrl(statusUrl);
const configured = Boolean(statusInfo.instance && statusInfo.id && statusUrl);
type CommentState = 'live' | 'setup' | 'disabled';
const state: CommentState = !MASTODON_COMMENTS.enabled || !enabled ? 'disabled' : configured ? 'live' : 'setup';
---

<section class="border-base-300 mt-12 border-t pt-8" aria-labelledby="comments-heading">
  <h2 id="comments-heading" class="mb-4 text-xl font-semibold">{t('post.comments')}</h2>

  {
    state === 'live' && (
      <div
        data-mastodon-comments
        data-instance={statusInfo.instance.replace(/\/$/, '')}
        data-status-id={statusInfo.id}
        data-status-url={statusUrl}
        data-locale={locale}
      >
        <p class="text-base-content text-sm">{t('post.commentsLoading')}</p>
      </div>
    )
  }

  {
    state === 'setup' && (
      <div role="note" class="border-base-300 bg-base-200/60 flex gap-4 rounded-none border p-5 text-sm sm:p-6">
        <div class="bg-info/15 text-info flex h-9 w-9 shrink-0 items-center justify-center rounded-none" aria-hidden="true">
          <Icon name="simple-icons:mastodon" width={18} height={18} />
        </div>
        <div class="min-w-0 flex-1">
          <p class="text-base-content text-base font-semibold">{t('post.commentsSetupTitle')}</p>
          <p class="text-base-content mt-1">{t('post.commentsSetupBody')}</p>
          <p class="text-base-content mt-3">
            Add <code class="rounded-none border border-base-300 bg-base-100 px-1.5 py-0.5 text-[0.8em] font-mono">mastodonStatusUrl</code> to this post's frontmatter.
          </p>
        </div>
      </div>
    )
  }

  {
    state === 'disabled' && (
      <p class="text-base-content text-sm italic">{t('post.commentsDisabled')}</p>
    )
  }
</section>

<script>
  type MastodonAccount = {
    display_name: string;
    username: string;
    acct: string;
    url: string;
    avatar: string;
  };

  type MastodonStatus = {
    id: string;
    url: string;
    content: string;
    created_at: string;
    account: MastodonAccount;
    in_reply_to_id: string | null;
  };

  const copy = {
    en: {
      empty: 'No replies yet. Reply on Mastodon to join the conversation.',
      reply: 'Reply on Mastodon',
      view: 'View on Mastodon',
      error: 'Could not load Mastodon comments.',
    },
    de: {
      empty: 'Noch keine Antworten. Antworte auf Mastodon, um mitzudiskutieren.',
      reply: 'Auf Mastodon antworten',
      view: 'Auf Mastodon ansehen',
      error: 'Mastodon-Kommentare konnten nicht geladen werden.',
    },
  } as const;

  function escapeHtml(input: string) {
    const node = document.createElement('div');
    node.textContent = input;
    return node.innerHTML;
  }

  function renderStatus(status: MastodonStatus) {
    const name = escapeHtml(status.account.display_name || status.account.username);
    const acct = escapeHtml(status.account.acct);
    return `
      <article class="border-base-300 rounded-none border p-4">
        <header class="mb-3 flex items-center gap-3">
          <img src="${status.account.avatar}" alt="" class="h-10 w-10 rounded-none" loading="lazy" />
          <div class="min-w-0">
            <a href="${status.account.url}" class="text-base-content hover:text-primary font-semibold" rel="nofollow noopener noreferrer" target="_blank">${name}</a>
            <p class="text-base-content truncate text-xs">@${acct}</p>
          </div>
          <a href="${status.url}" class="text-base-content hover:text-primary ml-auto text-xs" rel="nofollow noopener noreferrer" target="_blank">${new Date(status.created_at).toLocaleDateString()}</a>
        </header>
        <div class="prose-chirpy max-w-none text-sm">${status.content}</div>
      </article>`;
  }

  async function mountMastodonComments() {
    const mount = document.querySelector<HTMLElement>('[data-mastodon-comments]');
    if (!mount || mount.dataset.mounted === 'true') return;
    mount.dataset.mounted = 'true';

    const instance = mount.dataset.instance;
    const statusId = mount.dataset.statusId;
    const statusUrl = mount.dataset.statusUrl;
    const locale = mount.dataset.locale === 'de' ? 'de' : 'en';
    const strings = copy[locale];

    try {
      const response = await fetch(`${instance}/api/v1/statuses/${statusId}/context`);
      if (!response.ok) throw new Error(`Mastodon API returned ${response.status}`);
      const context = (await response.json()) as { descendants?: MastodonStatus[] };
      const replies = (context.descendants ?? []).filter((status) => status.in_reply_to_id === statusId);

      mount.innerHTML = `
        <div class="mb-4 flex flex-wrap gap-2">
          <a class="btn btn-primary btn-sm" href="${statusUrl}" target="_blank" rel="nofollow noopener noreferrer">${strings.reply}</a>
          <a class="btn btn-ghost btn-sm" href="${statusUrl}" target="_blank" rel="nofollow noopener noreferrer">${strings.view}</a>
        </div>
        ${replies.length ? `<div class="space-y-4">${replies.map(renderStatus).join('')}</div>` : `<p class="text-base-content text-sm">${strings.empty}</p>`}
      `;
    } catch (error) {
      console.error(error);
      mount.innerHTML = `<p class="text-error text-sm">${strings.error}</p>`;
    }
  }

  mountMastodonComments();
  document.addEventListener('astro:page-load', mountMastodonComments);
</script>
