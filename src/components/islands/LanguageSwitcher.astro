---
/**
 * Accessible language switcher.
 *
 * On post pages, the PostLayout sets `window.__chirpyTranslations` with a
 * map of locale -> absolute path to the translation sibling. The runtime
 * script in this island reads that map and rewrites the per-locale hrefs
 * so the user lands on the equivalent article.
 *
 * For other pages we strip the current pathname's locale prefix and
 * rebuild it for the target — preserving the path 1:1.
 */

import { SITE, type Locale } from '../../config';
import { useTranslations, localizedPath, stripLocale, localeLabel } from '../../i18n/utils';
import { Icon } from 'astro-icon/components';

export interface Props {
  locale: Locale;
  /**
   * Locales for which a translation of the current page actually
   * exists. Defaults to all `SITE.locales`. The current locale is
   * always treated as available.
   */
  availableLocales?: readonly Locale[];
}

const { locale, availableLocales } = Astro.props;
const t = useTranslations(locale);
const allowed = new Set<Locale>([locale, ...((availableLocales ?? SITE.locales) as Locale[])]);
const otherLocales = SITE.locales.filter((l) => l !== locale && allowed.has(l));
const fallbackBase = stripLocale(Astro.url.pathname);
---

{
  /* If the current page has no translations in any other locale, the
     switcher is just a static label \u2014 hide it entirely to avoid a
     dead-end menu. */
  otherLocales.length > 0 && (
    <div class="dropdown dropdown-end" data-lang-dropdown>
      <button
        type="button"
        tabindex="0"
        class="chirpy-social"
        aria-haspopup="menu"
        aria-expanded="false"
        aria-label={t('lang.switcher')}
        title={t('lang.switcher')}
        data-lang-dropdown-trigger
      >
        <Icon name="lucide:languages" width={16} height={16} />
      </button>
      <ul
        tabindex="0"
        class="menu dropdown-content border-base-300 bg-base-100 z-50 mt-2 w-44 rounded-none border p-2 shadow-lg"
        role="menu"
        data-lang-switcher
        data-lang-path={fallbackBase}
      >
        <li class="menu-title text-base-content px-2 py-1 text-xs tracking-wide uppercase">
          {t('lang.switcher')}
        </li>
        <li>
          <a href={localizedPath(fallbackBase, locale)} aria-current="true" class="font-medium">
            <span class="badge badge-primary badge-sm">{locale.toUpperCase()}</span>
            {localeLabel(locale)}
          </a>
        </li>
        {otherLocales.map((target) => (
          <li>
            <a
              href={localizedPath(fallbackBase, target)}
              data-lang-target={target}
              data-lang-fallback={localizedPath(fallbackBase, target)}
            >
              <span class="badge badge-ghost badge-sm">{target.toUpperCase()}</span>
              {localeLabel(target)}
            </a>
          </li>
        ))}
      </ul>
    </div>
  )
}

<script>
  type TranslationState = {
    path?: string;
    links?: Record<string, string>;
  };

  function rewireLanguageLinks() {
    const state = (window as unknown as { __chirpyTranslations?: TranslationState })
      .__chirpyTranslations;

    document.querySelectorAll<HTMLAnchorElement>('[data-lang-target]').forEach((a) => {
      const switcher = a.closest<HTMLElement>('[data-lang-switcher]');
      const currentPath = switcher?.dataset.langPath;
      const fallback = a.dataset.langFallback;
      const target = a.dataset.langTarget;
      const map = state?.links;
      const mapPath = state?.path;
      const mapApplies = Boolean(map && (!mapPath || mapPath === currentPath));

      if (target && mapApplies && map?.[target]) {
        a.href = map[target];
        return;
      }

      if (fallback) a.href = fallback;
    });
  }

  function closeLanguageDropdowns(except?: HTMLElement) {
    document.querySelectorAll<HTMLElement>('[data-lang-dropdown]').forEach((dropdown) => {
      if (dropdown === except) return;
      dropdown.classList.remove('is-open');
      dropdown
        .querySelector<HTMLButtonElement>('[data-lang-dropdown-trigger]')
        ?.setAttribute('aria-expanded', 'false');
    });
  }

  function setLanguageDropdownOpen(dropdown: HTMLElement, open: boolean) {
    dropdown.classList.toggle('is-open', open);
    dropdown
      .querySelector<HTMLButtonElement>('[data-lang-dropdown-trigger]')
      ?.setAttribute('aria-expanded', String(open));
  }

  function setupLanguageSwitcher() {
    const state = window as unknown as { __chirpyLanguageSwitcherBound?: boolean };
    if (state.__chirpyLanguageSwitcherBound) return;
    state.__chirpyLanguageSwitcherBound = true;

    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const trigger = target.closest<HTMLElement>('[data-lang-dropdown-trigger]');
      if (trigger) {
        const dropdown = trigger.closest<HTMLElement>('[data-lang-dropdown]');
        if (!dropdown) return;
        const nextOpen = !dropdown.classList.contains('is-open');
        closeLanguageDropdowns(dropdown);
        setLanguageDropdownOpen(dropdown, nextOpen);
        return;
      }

      const menuLink = target.closest<HTMLElement>('[data-lang-switcher] a');
      if (menuLink) {
        closeLanguageDropdowns();
        return;
      }

      if (!target.closest('[data-lang-dropdown]')) {
        closeLanguageDropdowns();
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeLanguageDropdowns();
    });
  }

  rewireLanguageLinks();
  setupLanguageSwitcher();
</script>
