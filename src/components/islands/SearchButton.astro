---
/** Header search trigger. The modal implementation is loaded on first use. */

import { useTranslations, withBase } from '../../i18n/utils';
import type { Locale } from '../../config';
import { Icon } from 'astro-icon/components';
import '../../styles/search.css';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const pagefindScript = withBase('/_pagefind/pagefind.js');

const i18n = {
  title: t('search.title'),
  placeholder: t('search.placeholder'),
  closeLabel: t('search.closeLabel'),
  clearLabel: t('search.clearLabel'),
  typeToStart: t('search.typeToStart'),
  searching: t('search.searching'),
  noResultsFor: t('search.noResultsFor'),
  resultsCount: t('search.resultsCount'),
  resultsCountOne: t('search.resultsCountOne'),
  hintShortcut: t('search.hintShortcut'),
  hintNavigate: t('search.hintNavigate'),
  hintSelect: t('search.hintSelect'),
};
---

<button
  type="button"
  class="search-pill"
  aria-label={t('search.openLabel')}
  title={t('search.openLabel')}
  data-search-open
  data-search-i18n={JSON.stringify(i18n)}
  data-pagefind-script={pagefindScript}
>
  <Icon name="lucide:search" width={16} height={16} class="search-pill__icon" />
  <span class="search-pill__label">{i18n.placeholder}</span>
  <kbd class="search-pill__kbd" aria-hidden="true">/</kbd>
</button>

<script>
  type SearchModalModule = typeof import('./search-modal');

  let searchModalPromise: Promise<SearchModalModule> | null = null;

  function loadSearchModal() {
    searchModalPromise ??= import('./search-modal');
    return searchModalPromise;
  }

  function getSearchConfig(trigger?: HTMLElement) {
    const source = trigger ?? document.querySelector<HTMLElement>('[data-search-open]');
    if (!source) return null;
    return {
      i18n: JSON.parse(source.dataset.searchI18n || '{}'),
      pagefindScript: source.dataset.pagefindScript || '',
    };
  }

  async function openSearch(trigger?: HTMLElement) {
    const config = getSearchConfig(trigger);
    if (!config) return;
    const { openSearchModal } = await loadSearchModal();
    openSearchModal(config);
  }

  function isTypingTarget(target: EventTarget | null) {
    if (!(target instanceof HTMLElement)) return false;
    if (target.isContentEditable) return true;
    const tag = target.tagName;
    return tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT';
  }

  const windowWithSearch = window as Window & {
    // eslint-disable-next-line no-unused-vars
    __searchClickHandler?: (event: MouseEvent) => void;
    // eslint-disable-next-line no-unused-vars
    __searchShortcutHandler?: (event: KeyboardEvent) => void;
  };
  if (windowWithSearch.__searchClickHandler) {
    document.removeEventListener('click', windowWithSearch.__searchClickHandler);
  }
  windowWithSearch.__searchClickHandler = (event: MouseEvent) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const trigger = target.closest<HTMLElement>('[data-search-open]');
    if (!trigger) return;
    event.preventDefault();
    openSearch(trigger);
  };
  document.addEventListener('click', windowWithSearch.__searchClickHandler);

  if (windowWithSearch.__searchShortcutHandler) {
    document.removeEventListener('keydown', windowWithSearch.__searchShortcutHandler);
  }
  windowWithSearch.__searchShortcutHandler = (event: KeyboardEvent) => {
    const isCmdK = (event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k';
    const isSlash =
      event.key === '/' &&
      !event.metaKey &&
      !event.ctrlKey &&
      !event.altKey &&
      !isTypingTarget(event.target);
    if (!isCmdK && !isSlash) return;
    event.preventDefault();
    openSearch();
  };
  document.addEventListener('keydown', windowWithSearch.__searchShortcutHandler);
</script>
