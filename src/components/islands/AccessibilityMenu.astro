---
import { useTranslations } from '../../i18n/utils';
import type { Locale } from '../../config';
import { Icon } from 'astro-icon/components';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<div class="relative" data-a11y-menu>
  <button
    type="button"
    class="chirpy-social"
    data-a11y-toggle
    aria-expanded="false"
    aria-controls="a11y-menu-panel"
    aria-label={t('a11y.menu')}
    title={t('a11y.menu')}
  >
    <Icon name="material-symbols:accessibility-new-rounded" width={18} height={18} />
  </button>

  <div
    id="a11y-menu-panel"
    class="border-base-300 bg-base-100 fixed bottom-20 left-2 z-50 hidden max-h-[calc(100vh-6rem)] w-[calc(100vw-1rem)] max-w-72 overflow-y-auto border p-3 text-left shadow-lg lg:bottom-16 lg:left-4"
    data-a11y-panel
  >
    <p class="text-base-content mb-2 text-sm font-semibold">{t('a11y.menu')}</p>

    <div class="space-y-1">
      <label
        class="hover:bg-base-200 flex cursor-pointer items-center justify-between gap-3 px-2 py-2 text-sm"
      >
        <span>
          <span class="text-base-content block font-medium">{t('a11y.smoothScroll')}</span>
          <span class="text-base-content block text-xs">{t('a11y.smoothScrollHint')}</span>
        </span>
        <input
          type="checkbox"
          class="toggle toggle-sm a11y-toggle-round !rounded-full"
          data-a11y-toggle-setting="smoothScroll"
        />
      </label>

      <label
        class="hover:bg-base-200 flex cursor-pointer items-center justify-between gap-3 px-2 py-2 text-sm"
      >
        <span class="text-base-content font-medium">{t('a11y.reduceMotion')}</span>
        <input
          type="checkbox"
          class="toggle toggle-sm a11y-toggle-round !rounded-full"
          data-a11y-toggle-setting="reduceMotion"
        />
      </label>

      <label
        class="hover:bg-base-200 flex cursor-pointer items-center justify-between gap-3 px-2 py-2 text-sm"
      >
        <span class="text-base-content font-medium">{t('a11y.highContrast')}</span>
        <input
          type="checkbox"
          class="toggle toggle-sm a11y-toggle-round !rounded-full"
          data-a11y-toggle-setting="highContrast"
        />
      </label>

      <label
        class="hover:bg-base-200 flex cursor-pointer items-center justify-between gap-3 px-2 py-2 text-sm"
      >
        <span class="text-base-content font-medium">{t('a11y.underlineLinks')}</span>
        <input
          type="checkbox"
          class="toggle toggle-sm a11y-toggle-round !rounded-full"
          data-a11y-toggle-setting="underlineLinks"
        />
      </label>
    </div>

    <label class="mt-3 block px-2 text-sm">
      <span class="text-base-content mb-1 block font-medium">{t('a11y.fontSize')}</span>
      <select
        class="select select-bordered select-sm text-center-last w-full text-center"
        data-a11y-select-setting="fontSize"
      >
        <option value="default">{t('a11y.default')}</option>
        <option value="large">{t('a11y.large')}</option>
        <option value="xlarge">{t('a11y.extraLarge')}</option>
      </select>
    </label>

    <label class="mt-3 block px-2 text-sm">
      <span class="text-base-content mb-1 block font-medium">{t('a11y.font')}</span>
      <select
        class="select select-bordered select-sm text-center-last w-full text-center"
        data-a11y-select-setting="font"
      >
        <option value="lexend">Lexend</option>
        <option value="opendyslexic">OpenDyslexic</option>
        <option value="serif">{t('a11y.serif')}</option>
        <option value="browser">{t('a11y.browserFont')}</option>
      </select>
    </label>
  </div>
</div>

<script>
  const KEYS = {
    smoothScroll: 'smooth-scroll-enabled',
    reduceMotion: 'a11y-reduce-motion',
    highContrast: 'a11y-high-contrast',
    underlineLinks: 'a11y-underline-links',
    fontSize: 'a11y-font-size',
    font: 'a11y-font',
  } as const;

  function readStorage(key: string) {
    try {
      return localStorage.getItem(key);
    } catch {
      return null;
    }
  }

  function writeStorage(key: string, value: string) {
    try {
      localStorage.setItem(key, value);
    } catch {
      /* ignore */
    }
  }

  function storedBool(key: string, fallback = false) {
    const value = readStorage(key);
    if (value == null) return fallback;
    return value === 'true';
  }

  function smoothScrollEnabled() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return false;
    if (storedBool(KEYS.reduceMotion)) return false;
    return readStorage(KEYS.smoothScroll) === 'true';
  }

  async function ensureOpenDyslexicFont() {
    if (document.getElementById('opendyslexic-font-face')) return;

    const [{ default: openDyslexicRegularUrl }, { default: openDyslexicBoldUrl }] =
      await Promise.all([
        import('@fontsource/opendyslexic/files/opendyslexic-latin-400-normal.woff2?url'),
        import('@fontsource/opendyslexic/files/opendyslexic-latin-700-normal.woff2?url'),
      ]);

    const style = document.createElement('style');
    style.id = 'opendyslexic-font-face';
    style.textContent = `
      @font-face {
        font-family: 'OpenDyslexic';
        font-style: normal;
        font-weight: 400;
        font-display: swap;
        src: url("${openDyslexicRegularUrl}") format("woff2");
      }
      @font-face {
        font-family: 'OpenDyslexic';
        font-style: normal;
        font-weight: 700;
        font-display: swap;
        src: url("${openDyslexicBoldUrl}") format("woff2");
      }
    `;
    document.head.append(style);
  }

  function applyA11ySettings() {
    const root = document.documentElement;
    root.dataset.a11yReduceMotion = storedBool(KEYS.reduceMotion) ? 'true' : 'false';
    root.dataset.a11yContrast = storedBool(KEYS.highContrast) ? 'high' : 'default';
    root.dataset.a11yUnderline = storedBool(KEYS.underlineLinks) ? 'true' : 'false';
    root.dataset.a11yFontSize = readStorage(KEYS.fontSize) || 'default';
    const font = readStorage(KEYS.font) || 'lexend';
    root.dataset.a11yFont = font;
    if (font === 'opendyslexic') void ensureOpenDyslexicFont();
  }

  function syncControls() {
    applyA11ySettings();
    document.querySelectorAll<HTMLInputElement>('[data-a11y-toggle-setting]').forEach((input) => {
      const setting = input.dataset.a11yToggleSetting;
      if (setting === 'smoothScroll') input.checked = smoothScrollEnabled();
      if (setting === 'reduceMotion') input.checked = storedBool(KEYS.reduceMotion);
      if (setting === 'highContrast') input.checked = storedBool(KEYS.highContrast);
      if (setting === 'underlineLinks') input.checked = storedBool(KEYS.underlineLinks);
    });
    document.querySelectorAll<HTMLSelectElement>('[data-a11y-select-setting]').forEach((select) => {
      const setting = select.dataset.a11ySelectSetting;
      if (setting === 'fontSize') select.value = readStorage(KEYS.fontSize) || 'default';
      if (setting === 'font') select.value = readStorage(KEYS.font) || 'lexend';
    });
  }

  function dispatchSmoothScrollChange() {
    document.dispatchEvent(
      new CustomEvent('smooth-scroll-preference-change', {
        detail: { enabled: smoothScrollEnabled() },
      }),
    );
  }

  let accessibilityMenuCleanup: AbortController | undefined;

  function setupAccessibilityMenu() {
    accessibilityMenuCleanup?.abort();
    accessibilityMenuCleanup = new AbortController();
    const { signal } = accessibilityMenuCleanup;

    applyA11ySettings();
    document.querySelectorAll<HTMLElement>('[data-a11y-menu]').forEach((menu) => {
      const button = menu.querySelector('[data-a11y-toggle]');
      const panel = menu.querySelector('[data-a11y-panel]');
      if (!button || !panel) return;

      const close = () => {
        panel.classList.add('hidden');
        button.setAttribute('aria-expanded', 'false');
      };

      button.addEventListener(
        'click',
        () => {
          const opening = panel.classList.contains('hidden');
          document
            .querySelectorAll<HTMLElement>('[data-a11y-panel]')
            .forEach((p) => p.classList.add('hidden'));
          document
            .querySelectorAll<HTMLButtonElement>('[data-a11y-toggle]')
            .forEach((b) => b.setAttribute('aria-expanded', 'false'));
          panel.classList.toggle('hidden', !opening);
          button.setAttribute('aria-expanded', String(opening));
        },
        { signal },
      );

      menu.querySelectorAll<HTMLInputElement>('[data-a11y-toggle-setting]').forEach((input) => {
        input.addEventListener(
          'change',
          () => {
            const setting = input.dataset.a11yToggleSetting;
            if (setting === 'smoothScroll')
              writeStorage(KEYS.smoothScroll, input.checked ? 'true' : 'false');
            if (setting === 'reduceMotion')
              writeStorage(KEYS.reduceMotion, input.checked ? 'true' : 'false');
            if (setting === 'highContrast')
              writeStorage(KEYS.highContrast, input.checked ? 'true' : 'false');
            if (setting === 'underlineLinks')
              writeStorage(KEYS.underlineLinks, input.checked ? 'true' : 'false');
            syncControls();
            dispatchSmoothScrollChange();
          },
          { signal },
        );
      });

      menu.querySelectorAll<HTMLSelectElement>('[data-a11y-select-setting]').forEach((select) => {
        select.addEventListener(
          'change',
          () => {
            const setting = select.dataset.a11ySelectSetting;
            if (setting === 'fontSize') writeStorage(KEYS.fontSize, select.value);
            if (setting === 'font') writeStorage(KEYS.font, select.value);
            syncControls();
          },
          { signal },
        );
      });

      document.addEventListener(
        'click',
        (event) => {
          if (!menu.contains(event.target as Node)) close();
        },
        { signal },
      );
      document.addEventListener(
        'keydown',
        (event) => {
          if (event.key === 'Escape') close();
        },
        { signal },
      );
    });

    syncControls();
  }

  applyA11ySettings();
  setupAccessibilityMenu();
  document.addEventListener('smooth-scroll-preference-change', syncControls);
  document.addEventListener('astro:page-load', setupAccessibilityMenu);
</script>
