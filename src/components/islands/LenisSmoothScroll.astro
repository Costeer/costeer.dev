<script>
  const STORAGE_KEY = 'smooth-scroll-enabled';
  type LenisConstructor = typeof import('lenis').default;
  type LenisInstance = InstanceType<LenisConstructor>;

  let lenis: LenisInstance | undefined;
  let lenisConstructorPromise: Promise<LenisConstructor> | undefined;
  let rafId = 0;
  let idleId = 0;
  let timeoutId = 0;

  function prefersReducedMotion() {
    return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  function shouldEnableSmoothScroll() {
    if (prefersReducedMotion()) return false;
    if (localStorage.getItem('a11y-reduce-motion') === 'true') return false;
    return localStorage.getItem(STORAGE_KEY) === 'true';
  }

  function loadLenis() {
    lenisConstructorPromise ??= import('lenis').then(
      ({ default: Lenis }) => Lenis as LenisConstructor,
    );
    return lenisConstructorPromise;
  }

  function cancelScheduledStart() {
    if (idleId && 'cancelIdleCallback' in window) {
      window.cancelIdleCallback(idleId);
    }
    if (timeoutId) clearTimeout(timeoutId);
    idleId = 0;
    timeoutId = 0;
  }

  function stopLenis() {
    cancelScheduledStart();
    if (rafId) cancelAnimationFrame(rafId);
    rafId = 0;
    lenis?.destroy();
    lenis = undefined;
    document.documentElement.removeAttribute('data-lenis-smooth');
  }

  async function startLenis() {
    if (lenis || !shouldEnableSmoothScroll()) return;
    const Lenis = await loadLenis();
    if (lenis || !shouldEnableSmoothScroll()) return;

    lenis = new Lenis({
      duration: 0.6,
      wheelMultiplier: 0.75,
      touchMultiplier: 0.9,
      smoothWheel: true,
      syncTouch: false,
    });
    document.documentElement.setAttribute('data-lenis-smooth', 'true');

    const raf = (time: number) => {
      lenis?.raf(time);
      rafId = requestAnimationFrame(raf);
    };
    rafId = requestAnimationFrame(raf);
  }

  function scheduleLenisStart() {
    cancelScheduledStart();
    if (!shouldEnableSmoothScroll() || lenis) return;

    const schedule = () => {
      timeoutId = window.setTimeout(() => {
        timeoutId = 0;
        void startLenis();
      }, 120);
    };

    if ('requestIdleCallback' in window) {
      idleId = window.requestIdleCallback(
        () => {
          idleId = 0;
          void startLenis();
        },
        { timeout: 1200 },
      );
    } else {
      schedule();
    }
  }

  function applySmoothScrollPreference() {
    if (shouldEnableSmoothScroll()) scheduleLenisStart();
    else stopLenis();
  }

  applySmoothScrollPreference();
  window.addEventListener('popstate', stopLenis, { capture: true });
  document.addEventListener('astro:before-swap', stopLenis);
  document.addEventListener('astro:page-load', applySmoothScrollPreference);
  document.addEventListener('smooth-scroll-preference-change', applySmoothScrollPreference);
  window
    .matchMedia('(prefers-reduced-motion: reduce)')
    .addEventListener('change', applySmoothScrollPreference);
</script>
