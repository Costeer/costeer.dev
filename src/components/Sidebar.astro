---
/**
 * Chirpy-style fixed left sidebar: avatar + site title + tagline,
 * uppercase vertical nav with icon bullets, theme toggle + social
 * pinned to the bottom.
 */

import { SITE, NAV, SOCIALS, type Locale } from '../config';
import { useTranslations, localizedPath, withBase } from '../i18n/utils';
import type { UIKey } from '../i18n/ui';
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import ThemeToggle from './islands/ThemeToggle.astro';
import AccessibilityMenu from './islands/AccessibilityMenu.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const home = localizedPath('/', locale);
const avatar = SITE.author.avatar;
const isStringAvatar = typeof avatar === 'string';
const avatarSrc = isStringAvatar ? avatar.trim() : '';

const navItems = NAV.map((item) => ({
  ...item,
  href: localizedPath(item.href, locale),
  label: t(`nav.${item.key}` as UIKey),
}));
---

<aside id="sidebar" class="chirpy-sidebar" aria-label="Sidebar">
  {/* Profile */}
  <a href={home} class="block" aria-label={SITE.title}>
    <span
      class="sidebar-profile-avatar"
      style="background:linear-gradient(135deg, var(--color-primary), color-mix(in oklab, var(--color-primary) 70%, black));"
    >
      {
        avatar ? (
          isStringAvatar ? (
            <img
              src={avatarSrc.startsWith('/') ? withBase(avatarSrc) : avatarSrc}
              alt={SITE.author.name}
              width="200"
              height="200"
              class="object-cover"
              loading="eager"
              decoding="async"
            />
          ) : (
            <Image
              src={avatar}
              alt={SITE.author.name}
              width={200}
              height={200}
              class="object-cover"
              loading="eager"
              decoding="async"
            />
          )
        ) : (
          <span class="text-primary-content flex h-full w-full items-center justify-center text-5xl font-bold">
            {SITE.title.charAt(0)}
          </span>
        )
      }
    </span>
    <span class="sidebar-profile-name">{SITE.author.name} · he/him</span>
  </a>

  <dl class="sidebar-profile-details">
    {
      SITE.author.bio && (
        <div class="sidebar-profile-bio">
          <dd>{SITE.author.bio}</dd>
        </div>
      )
    }
    <div></div>
  </dl>

  {/* Vertical nav */}
  <nav class="chirpy-nav flex-1" aria-label="Main">
    <ul class="contents flex-col gap-0.5">
      {
        navItems.map((item) => {
          const stripped = item.href.replace(/\/+$/, '') || '/';
          const current = Astro.url.pathname.replace(/\/+$/, '') || '/';
          const isActive =
            stripped === current ||
            (stripped !== home.replace(/\/+$/, '') && current.startsWith(stripped + '/'));
          return (
            <li>
              <a
                href={item.href}
                aria-current={isActive ? 'page' : undefined}
                class="chirpy-nav-link"
                data-sidebar-nav-link
                data-sidebar-home={item.href === home ? 'true' : undefined}
              >
                <Icon name={item.icon ?? 'lucide:home'} width={16} height={16} />
                <span>{item.label}</span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>

  {/* Bottom row: theme toggle + socials */}

  <div class="footer-notice">
    <ThemeToggle locale={locale} />
    <AccessibilityMenu locale={locale} />
    {
      SOCIALS.map((s) => (
        <a
          href={s.href.startsWith('/') ? withBase(s.href) : s.href}
          rel={s.rel ?? 'noopener'}
          class="chirpy-social"
          aria-label={s.label}
          target={s.href.startsWith('http') || s.label === 'RSS' ? '_blank' : undefined}
        >
          <Icon name={s.icon} width={16} height={16} />
        </a>
      ))
    }
  </div>
</aside>

{/* Mobile backdrop */}
<button
  type="button"
  data-sidebar-mask
  class="fixed inset-0 z-30 hidden bg-black/40 lg:hidden"
  aria-label="Close sidebar"
  tabindex="-1"></button>

<script>
  let sidebarCleanup: AbortController | undefined;

  function normalizedPath(pathname: string) {
    return pathname.replace(/\/+$/, '') || '/';
  }

  function updateSidebarActiveState() {
    const current = normalizedPath(window.location.pathname);

    document.querySelectorAll<HTMLAnchorElement>('[data-sidebar-nav-link]').forEach((link) => {
      const linkPath = normalizedPath(new URL(link.href, window.location.href).pathname);
      const isHome = link.dataset.sidebarHome === 'true';
      const isActive = linkPath === current || (!isHome && current.startsWith(`${linkPath}/`));

      if (isActive) {
        link.setAttribute('aria-current', 'page');
      } else {
        link.removeAttribute('aria-current');
      }
    });
  }

  function setupSidebar() {
    sidebarCleanup?.abort();
    sidebarCleanup = new AbortController();
    const { signal } = sidebarCleanup;
    const sidebar = document.getElementById('sidebar');
    const mask = document.querySelector<HTMLElement>('[data-sidebar-mask]');
    if (!sidebar || !mask) return;

    function open() {
      sidebar?.classList.add('is-open');
      mask?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }
    function close() {
      sidebar?.classList.remove('is-open');
      mask?.classList.add('hidden');
      document.body.style.overflow = '';
    }

    document.querySelectorAll<HTMLElement>('[data-sidebar-toggle]').forEach((btn) => {
      btn.addEventListener(
        'click',
        () => {
          if (sidebar?.classList.contains('is-open')) close();
          else open();
        },
        { signal },
      );
    });
    mask.addEventListener('click', close, { signal });
    document.addEventListener(
      'keydown',
      (e) => {
        if (e.key === 'Escape') close();
      },
      { signal },
    );
    // Close when clicking a sidebar link on mobile
    sidebar.querySelectorAll('a').forEach((a) => {
      a.addEventListener(
        'click',
        () => {
          if (window.matchMedia('(max-width: 1023px)').matches) close();
        },
        { signal },
      );
    });

    updateSidebarActiveState();
  }
  setupSidebar();
  document.addEventListener('astro:page-load', setupSidebar);
</script>
