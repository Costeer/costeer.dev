---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PostList from '~/components/PostList.astro';
import HomeFilters from '~/components/HomeFilters.astro';
import HomeInfiniteFeed from '~/components/HomeInfiniteFeed.astro';
import { SITE } from '~/config';
import { getVisiblePosts } from '~/utils/posts';

export function getStaticPaths() {
  return SITE.locales.map((l) => ({
    params: { locale: l === SITE.defaultLocale ? undefined : l },
    props: { locale: l },
  }));
}
const { locale } = Astro.props;

const posts = await getVisiblePosts(locale);
const recentPosts = posts.slice(0, SITE.postsPerPage);
---

<BaseLayout title={SITE.title} description={SITE.description} pathWithoutLocale="/">
  <HomeFilters posts={posts} locale={locale} />
  <PostList posts={recentPosts} locale={locale} animate lazyRender showReadingDepth />
  <HomeInfiniteFeed locale={locale} totalPosts={posts.length} />
</BaseLayout>
