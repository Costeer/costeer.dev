---
import { SITE } from '~/config';

import BaseLayout from '~/layouts/BaseLayout.astro';
import { useTranslations } from '~/i18n/utils';
import { getCategoriesWithCount, categoryPath } from '~/utils/posts';
import { Icon } from 'astro-icon/components';

export function getStaticPaths() {
  return SITE.locales.map((l) => ({
    params: { locale: l === SITE.defaultLocale ? undefined : l },
    props: { locale: l },
  }));
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const categories = await getCategoriesWithCount(locale);
---

<BaseLayout
  title={t('categories.title')}
  pathWithoutLocale="/categories/"
  crumbs={[{ label: t('categories.title') }]}
>
  <section class="px-1 pt-3 pb-6 sm:px-2 sm:pt-4 sm:pb-8">
    <header class="chirpy-page-header mb-6">
      <h1 class="text-3xl font-bold tracking-tight">{t('categories.title')}</h1>
    </header>
    {
      categories.length === 0 ? (
        <p class="text-base-content">{t('categories.empty')}</p>
      ) : (
        <ul class="grid min-w-0 gap-3 sm:grid-cols-2 md:grid-cols-3">
          {categories.map((cat) => (
            <li class="min-w-0">
              <a
                href={categoryPath(locale, cat.name)}
                class="border-base-300 bg-base-200 hover:bg-base-300 flex min-h-full items-center gap-3 border p-4 text-base-content no-underline transition-colors"
              >
                  <Icon name="lucide:folder" width={20} height={20} class="text-primary" />
                  <div class="min-w-0 flex-1">
                    <p class="truncate font-semibold">{cat.name}</p>
                    <p class="text-base-content text-xs">
                      {cat.count} {cat.count === 1 ? t('list.totalPostsOne') : t('list.totalPosts')}
                    </p>
                  </div>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>
