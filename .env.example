# Public site URL (no trailing slash). Used for canonical, OG, hreflang, sitemap.
SITE_URL=https://costeer.dev

# Sub-path the site is served from. Leave blank (or set to "/") for local
# dev and root-domain hosting; set to "/<repo>" when deploying to GitHub
# Pages so all asset URLs resolve correctly.
#   examples:  BASE_PATH=/chirping-astro     (GitHub Pages)
#              BASE_PATH=                    (root domain or `bun run dev`)
BASE_PATH=

# --- Author / social handles ---
# Leave any optional handle blank to hide the corresponding social link.
PUBLIC_CODEBERG_HANDLE=Costeer
PUBLIC_CODEBERG_REPO=costeer.dev
PUBLIC_TWITTER_HANDLE=costeer
PUBLIC_CONTACT_EMAIL=public@costeer.dev

PUBLIC_MASTODON_COMMENTS_ENABLED=true
PUBLIC_MASTODON_INSTANCE=https://mastodon.de
PUBLIC_MASTODON_PROFILE_URL=https://mastodon.de/@costeer
