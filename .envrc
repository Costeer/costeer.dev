# direnv configuration for costeer.dev
#
# Usage:
#   1. Install direnv and nix-direnv.
#   2. Run `direnv allow` in this directory.
#
# This loads the Nix development shell so Bun, Node.js, Git, certificates,
# and project-local Bun cache paths are available automatically.

watch_file flake.nix
watch_file flake.lock
watch_file shell.nix
watch_file package.json
watch_file bun.lock

# Prefer nix-direnv's cached loader when available. Fall back to plain nix.
if has nix_direnv_version; then
  nix_direnv_version 3.0.6
  use flake
elif has nix; then
  use flake
else
  use nix
fi
